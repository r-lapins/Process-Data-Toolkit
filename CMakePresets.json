{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDT_ENABLE_SANITIZERS": "ON",
        "PDT_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "debug-qt",
      "displayName": "debug-qt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDT_ENABLE_SANITIZERS": "ON",
        "PDT_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "debug-nosan",
      "displayName": "Debug (no sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-nosan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDT_ENABLE_SANITIZERS": "OFF",
        "PDT_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "debug-cuda-nosan",
      "displayName": "Debug (CUDA, no sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-cuda-nosan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDT_ENABLE_SANITIZERS": "OFF",
        "PDT_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "debug-rtlsdr-cuda-nosan",
      "displayName": "Debug (RTL-SDR, CUDA, no sanitizers)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-rtlsdr-cuda-nosan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PDT_ENABLE_SANITIZERS": "OFF",
        "PDT_ENABLE_CUDA": "ON",
        "PDT_BUILD_RTLSDR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PDT_ENABLE_SANITIZERS": "OFF",
        "PDT_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "release-cuda",
      "displayName": "Release (CUDA)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PDT_ENABLE_SANITIZERS": "OFF",
        "PDT_ENABLE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-qt",
      "configurePreset": "debug-qt"
    },
    {
      "name": "debug-nosan",
      "configurePreset": "debug-nosan"
    },
    {
      "name": "debug-cuda-nosan",
      "configurePreset": "debug-cuda-nosan"
    },
    {
      "name": "debug-rtlsdr-cuda-nosan",
      "configurePreset": "debug-rtlsdr-cuda-nosan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-qt",
      "configurePreset": "debug-qt",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-nosan",
      "configurePreset": "debug-nosan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-cuda-nosan",
      "configurePreset": "debug-cuda-nosan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-rtlsdr-cuda-nosan",
      "configurePreset": "debug-rtlsdr-cuda-nosan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-cuda",
      "configurePreset": "release-cuda",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
